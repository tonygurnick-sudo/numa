// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/terraform:1": {},
    "ghcr.io/devcontainers-contrib/features/poetry:2": {},
    "ghcr.io/eitsupi/devcontainer-features/jq-likes:2": {},
    "ghcr.io/devcontainers-contrib/features/pre-commit:2": {}
  },
  // Features to add to the dev container. More info: https://containers.dev/features.
  // "features": {},
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],
  // Use 'postCreateCommand' to run commands after the container is created.
  // "postCreateCommand": "pip3 install --user -r requirements.txt",
  // Configure tool-specific properties.
  // "customizations": {},
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.npmrc,target=/home/vscode/.npmrc,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.yarnrc.yml,target=/home/vscode/.yarnrc.yml,type=bind,consistency=cached",
    // The following are the mounts for poetry config from the host OS into the container. Uncomment the appropriate one for your system.
    // MacOS.
    // "source=${localEnv:HOME}/Library/Application Support/pypoetry/,target=/home/vscode/.config/pypoetry,type=bind,consistency=cached"
    // Windows
    // "source=${localEnv:APPDATA}/pypoetry/,target=/home/vscode/.config/pypoetry,type=bind,consistency=cached"
    // Linux
    // "source=${localEnv:HOME}/.config/pypoetry,target=/home/vscode/.config/pypoetry,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black",
        "ms-python.isort",
        "ms-python.flake8"
      ]
    }
  },
  "containerEnv": {
    "POETRY_VIRTUALENVS_IN_PROJECT": "true"
  }
}
