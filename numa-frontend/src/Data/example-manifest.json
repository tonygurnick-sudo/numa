      "category": "hr",
      "tags": ["risk-assessment", "governance", "audit", "regulatory"],
      "createdDate": "2023-11-06T10:38:12Z",
      "appDescription": "Processes a file through S3, Q App, and Lambda, then displays the output.",
      "tasks": [
        {
          "id": "upload-file-to-s3-bucket",
          "title": "Upload a file",
          "type": "s3-upload",
          "params": {
            "bucketName": "my-bucket",
            "fileKey": "uploads/input_file.txt"
          },
          "order": 1
        },
        {
          "id": "process-with-q-app",
          "title": "Process with Q App",
          "type": "q-app",
          "params": {
            "qAppId": "q-app-123",
            "inputContentRef": "upload-file-to-s3-bucket",
            "outputKey": "q-app-output"
          },
          "order": 2
        },
        {
          "id": "process-with-lambda",
          "title": "Process with Lambda",
          "type": "backend",
          "params": {
            "lambdaArn": "arn:aws:lambda:us-east-1:123456789012:function:my-lambda-function",
            "input": {
              "inputContentRef": "process-with-q-app"
            }
          },
          "order": 3
        },
        {
          "id": "display-output",
          "title": "Display Output",
          "type": "text-output",
          "params": {
            "dataRef": "process-with-lambda"
          },
          "order": 4
        }
      ]
    },
