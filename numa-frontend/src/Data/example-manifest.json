{
  "apps": [
    {
      "appName": "Policy Designer",
      "id": "policy-builder-app",
      "type": "policy-builder",
      "status": "Active",
      "category": "compliance",
      "tags": ["NZSBA"],
      "createdDate": "2024-03-20T10:00:00Z",
      "appDescription": "Create and manage organizational policies with AI assistance. This tool helps draft, review, and format policies while ensuring compliance with industry standards and regulations.",
      "tasks": [
        {
          "id": "policy-type-selection",
          "title": "Select Policy Type",
          "type": "dropdown",
          "required": true,
          "params": {
            "options": [
              "IT Security Policy",
              "HR Policy",
              "Compliance Policy",
              "Operations Policy",
              "Custom Policy"
            ]
          },
          "order": 1
        },
        {
          "id": "policy-requirements",
          "title": "Policy Requirements",
          "type": "text-input",
          "description": "Describe the key requirements and objectives for this policy",
          "required": true,
          "order": 2
        },
        {
          "id": "generate-policy",
          "title": "Generate Policy Draft",
          "type": "q-app",
          "appVersion": "1",
          "params": {
            "qAppId": "policy-generator-q-app",
            "inputs": [
              {
                "inputContentRef": "@policy-type-selection",
                "qInputCardId": "policy-type"
              },
              {
                "inputContentRef": "@policy-requirements",
                "qInputCardId": "requirements"
              }
            ],
            "qOutputCardId": "policy-draft"
          },
          "order": 3
        },
        {
          "id": "display-policy",
          "title": "Review Policy",
          "type": "text-output",
          "params": {
            "dataRef": "@generate-policy"
          },
          "order": 4
        }
      ]
    },
    {
      "appName": "Meeting Analyser",
      "id": "meeting-analyser",
      "type": "numa-app",
      "status": "Active",
      "category": "productivity",
      "createdDate": "2025-01-31",
      "appDescription": "Transform raw meeting data into comprehensive summaries, insightful analyses, and actionable outputs. Whether your meetings are in\nperson, virtual, or a blend of both, this app helps you make the most out of\nyour meeting notes and transcripts by providing structured, automated reports\nand follow-up resources.",
      "tasks": [
        {
          "id": "upload-files-to-s3",
          "title": "Upload Files",
          "description": "Upload your notes or transcripts from your meeting",
          "type": "s3-upload",
          "required": true,
          "order": 1,
          "params": {
            "bucketName": "numa-meeting-notes"
          }
        },
        {
          "id": "template-task",
          "description": "The structure you would like your meeting summary to follow",
          "title": "Template",
          "type": "text-input",
          "default": "\n              - summarise the discussion\n              - summarise the event\n              - outline the requirements\n              - actions and next steps\n          ",
          "order": 2
        },
        {
          "id": "other-notes",
          "title": "Other Notes",
          "description": "Any other notes that might be useful such as participants (if not in transcript), prior meeting context, etc",
          "type": "text-input",
          "order": 3
        },
        {
          "id": "call-step-function",
          "title": "Process Meeting Notes",
          "type": "http-request",
          "endpoint": "meeting-analyser",
          "params": {
            "payload": {
              "uploaded_files": "@upload-files-to-s3",
              "template": "@template-task",
              "other_notes": "@other-notes"
            }
          },
          "order": 4
        },
        {
          "id": "meeting-summary",
          "title": "Meeting Summary",
          "type": "text-output",
          "params": {
            "dataRef": "@call-step-function/summary"
          },
          "order": 5
        },
        {
          "id": "action-items",
          "title": "Action Items",
          "type": "text-output",
          "params": {
            "dataRef": "@call-step-function/action_items"
          },
          "order": 6
        },
        {
          "id": "follow-up-emails",
          "title": "Follow-up Emails",
          "type": "text-output",
          "params": {
            "dataRef": "@call-step-function/follow_up_emails"
          },
          "order": 7
        },
        {
          "id": "key-decisions",
          "title": "Key Decisions",
          "type": "text-output",
          "params": {
            "dataRef": "@call-step-function/key_decisions"
          },
          "order": 8
        }
      ]
    },
    {
      "appName": "Meeting Tools App",
      "id": "meeting-tools-app",
      "type": "numa-app",
      "status": "Active",
      "appVersion": 0.02,
      "category": "productivity",
      "tags": [
        "meeting",
        "analysis",
        "productivity",
        "insights",
        "note-taking",
        "transcript",
        "meeting-minutes",
        "action-items",
        "follow-up",
        "summary",
        "reporting"
      ],
      "createdDate": "2023-11-06T10:38:12Z",
      "appDescription": "The Meeting Insights and Analysis Tool is designed to transform raw meeting data into comprehensive summaries, insightful analyses, and actionable outputs. Whether your meetings are in person, virtual, or a blend of both, this app helps you make the most out of your meeting notes and transcripts by providing structured, automated reports and follow-up resources.",
      "tasks": [
        {
          "id": "upload-files-to-s3",
          "title": "Upload Files",
          "description": "Upload your notes or transcript from your meeting",
          "type": "s3-upload",
          "required": true,
          "params": {
            "bucketName": "numa-meeting-notes"
          },
          "order": 1
        },
        {
          "id": "template-task",
          "title": "Template",
          "type": "text-input",
          "default": "- summarise the discussion\n- summarise the event\n- outline the requirements\n- actions and next steps",
          "order": 1
        },
        {
          "id": "other-notes",
          "title": "Other Notes",
          "required": false,
          "description": "Include any other notes that might be useful.",
          "type": "text-input",
          "default": "other notes:",
          "order": 1
        },
        {
          "id": "call-step-function",
          "title": "Process Meeting Notes",
          "type": "http-request",
          "requiredTasks": {
            "any": ["@upload-files-to-s3"]
          },
          "endpoint": "meeting-tools",
          "params": {
            "payload": {
              "uploadedFiles": [
                {
                  "bucket": "numa-q-dev",
                  "key": "@upload-files-to-s3"
                }
              ]
            }
          },
          "order": 2
        },
        {
          "id": "process-with-q-app",
          "title": "Process with Q App",
          "type": "q-app",
          "appVersion": "1",
          "params": {
            "qAppId": "d152ee6f-a1e8-40ea-810e-aa006790a897",
            "inputs": [
              {
                "inputContentRef": "@call-step-function",
                "base64encode": true,
                "qInputCardId": "049d6293-781a-4f81-bb1e-2c325c854af6"
              },
              {
                "inputContentRef": "@template-task",
                "qInputCardId": "205e13b4-1e56-4596-a5e1-68f0b11dae94"
              },
              {
                "inputContentRef": "@other-notes",
                "qInputCardId": "a588c763-c6c5-4a0d-a157-cf5f27face3c"
              }
            ],
            "outputs": [
              {
                "outputContentRef": "@show-meeting-summary",
                "qOutputCardId": "cfab5818-6cbe-483b-8c46-c3e1a6288ea6"
              },
              {
                "outputContentRef": "@show-template-results",
                "qOutputCardId": "000f12a3-489b-4fc7-8f31-7d9a7c31a54f"
              }
            ]
          },
          "order": 3
        },
        {
          "id": "meeting-summary-results",
          "title": "Meeting Summary & Analysis",
          "type": "text-output",
          "params": {
            "dataRef": "@show-meeting-summary"
          },
          "order": 4
        },
        {
          "id": "template-results",
          "title": "Template Results",
          "type": "text-output",
          "params": {
            "dataRef": "@show-template-results"
          },
          "order": 4
        }
      ]
    },
    {
      "appName": "Numa App Workflow",
      "id": "numa-workflow-app-id",
