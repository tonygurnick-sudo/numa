{
  "apps": [
    {
      "appName": "Meeting Tools App",
      "id": "meeting-tools-app",
      "type": "numa-app",
      "status": "Active",
      "createdDate": "2023-11-06T10:38:12Z",
      "appDescription": "Processes meeting notes.",
      "tasks": [
        {
          "id": "upload-files-to-s3",
          "title": "Upload Files (Optional)",
          "type": "s3-upload",
          "params": {
            "bucketName": "meeting-notes-bucket"
          },
          "order": 1
        },
        {
          "id": "meeting-notes-task",
          "title": "Your Meeting Notes (Optional)",
          "type": "text-input",
          "order": 1
        },
        {
          "id": "meeting-notes-description-task",
          "title": "Describe your meeting notes",
          "type": "text-input",
          "order": 1
        },
        {
          "id": "meeting-context-task",
          "title": "Your Meeting Context",
          "type": "text-input",
          "order": 1
        },
        {
          "id": "transcript-task",
          "title": "Transcript",
          "type": "text-input",
          "order": 1
        },
        {
          "id": "other-notes",
          "title": "Other Notes",
          "type": "text-input",
          "order": 1
        },
        {
          "id": "call-step-function",
          "title": "Process Meeting Notes",
          "type": "http-request",
          "requiredTasks": {
            "any": [
              "upload-files-to-s3",
              "meeting-notes-task",
              "transcript-task"
            ]
          },
          "endpoint": "meeting-tools",
          "params": {
            "payload": {
              "uploadedFiles": [
                {
                  "bucket": "numa-q-dev",
                  "key": "@upload-files-to-s3",
                  "type": "meetingNotes",
                  "description": "Meeting Notes."
                }
              ],
              "meetingNotes": {
                "text": "@meeting-notes-task",
                "description": "@meeting-notes-description-task"
              },
              "transcript": "@transcript-task",
              "meetingContext": "@meeting-context-task",
              "otherNotes": "@other-notes",
              "template": "No idea about a template..."
            }
          },
          "order": 2
        },
        {
          "id": "process-with-q-app",
          "title": "Process with Q App",
          "type": "q-app",
          "params": {
            "qAppId": "q-app-123",
            "inputContentRef": "@call-step-function",
            "qInputCardId": "the-uuid-of-the-input-card-to-populate",
            "qOutputCardId": "the-uuid-of-the-output-card-to-get-value-from"
          },
          "order": 3
        },
        {
          "id": "display-results",
          "title": "Display Results",
          "type": "text-output",
          "params": {
            "dataRef": "process-with-q-app"
          },
          "order": 4
        }
      ]
    },
    {
      "appName": "Numa App Workflow",
      "id": "numa-workflow-app-id",
      "type": "numa-app",
      "status": "Coming Soon",
      "createdDate": "2023-11-06T10:38:12Z",
      "appDescription": "Processes a file through S3, Q App, and Lambda, then displays the output.",
      "tasks": [
        {
          "id": "upload-file-to-s3-bucket",
          "title": "Upload a file",
          "type": "s3-upload",
          "params": {
            "bucketName": "my-bucket",
            "fileKey": "uploads/input_file.txt"
          },
          "order": 1
        },
        {
          "id": "process-with-q-app",
          "title": "Process with Q App",
          "type": "q-app",
          "params": {
            "qAppId": "q-app-123",
            "inputContentRef": "upload-file-to-s3-bucket",
            "outputKey": "q-app-output"
          },
          "order": 2
        },
        {
          "id": "process-with-lambda",
          "title": "Process with Lambda",
          "type": "backend",
          "params": {
            "lambdaArn": "arn:aws:lambda:us-east-1:123456789012:function:my-lambda-function",
            "input": {
              "inputContentRef": "process-with-q-app"
            }
          },
          "order": 3
        },
        {
          "id": "display-output",
          "title": "Display Output",
          "type": "text-output",
          "params": {
            "dataRef": "process-with-lambda"
          },
          "order": 4
        }
      ]
    },
    {
      "appName": "Loan Refinancing Calculator",
      "id": "loan-financing-calculator",
      "type": "q-app",
      "qAppId": "dc1427b5-7673-4c26-9add-5bda95c00b30",
      "status": "Coming Soon",
      "createdDate": "2023-11-06T10:38:12Z",
      "appDescription": "An app to calculate if refinancing a loan is worth it based on current and new loan details."
    },
    {
      "appName": "Data Processing App",
      "id": "data-processing-app-id",
      "type": "numa-app",
      "status": "Test",
      "createdDate": "2023-11-06T10:38:12Z",
      "appDescription": "Processes raw data and generates insights.",
      "tasks": [
        {
          "id": "upload-files-to-s3",
          "title": "Upload a file",
          "type": "s3-upload",
          "params": {
            "bucketName": "raw-data-bucket",
            "fileKeyPrefix": "processed-files/"
          },
          "order": 1
        },
        {
          "id": "data-analysis",
          "title": "Data Analysis",
          "type": "http-request",
          "endpoint": "data-analys-etc",
          "params": {
            "payload": {
              "content": {
                "uploadedFiles": "@upload-files-to-s3"
              }
            }
          },
          "order": 2
        },
        {
          "id": "display-insights",
          "title": "Display Insights",
          "type": "text-output",
          "params": {
            "dataRef": "data-analysis"
          },
          "order": 3
        }
      ]
    },
    {
      "appName": "Machine Learning Model Deployment App",
      "id": "ml-model-deployment-app-id",
      "type": "numa-app",
      "status": "",
      "createdDate": "2023-11-06T10:38:12Z",
      "appDescription": "Deploys a machine learning model to a cloud platform.",
      "tasks": [
        {
          "id": "model-deployment",
          "title": "Model Deployment",
          "type": "backend",
          "params": {
            "lambdaArn": "arn:aws:lambda:us-east-1:123456789012:function:model-deployment-step-function"
          },
          "order": 1
        },

        {
          "id": "display-model-metrics",
          "title": "Display Model Metrics",
          "type": "text-output",
          "params": {
            "dataRef": "model-monitoring"
          },
          "order": 2
        }
      ]
    }
  ]
}
