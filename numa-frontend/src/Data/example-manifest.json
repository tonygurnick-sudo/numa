        {
          "id": "data-analysis",
          "title": "Data Analysis",
          "type": "http-request",
          "endpoint": "data-analys-etc",
          "params": {
            "payload": {
              "content": {
                "uploadedFiles": "@upload-files-to-s3"
              }
            }
          },
          "order": 2
        },
        {
          "id": "display-insights",
          "title": "Display Insights",
          "type": "text-output",
          "params": {
            "dataRef": "data-analysis"
          },
          "order": 3
        }
      ]
    },
    {
