{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "qbusiness:Chat*",
        "qbusiness:List*",
        "qbusiness:DeleteConversation",
        "qbusiness:PutFeedback",
        "qbusiness:StartDataSourceSyncJob",
        "qapps:*",
        "qbusiness:Get*"
      ],
      "Resource": [
        "arn:aws:qbusiness:us-east-1:905418183804:application/2594236d-712a-4355-8b0e-6a4cef023f75",
        "arn:aws:qbusiness:us-east-1:905418183804:application/2594236d-712a-4355-8b0e-6a4cef023f75/index/*",
        "arn:aws:qbusiness:us-east-1:905418183804:application/2594236d-712a-4355-8b0e-6a4cef023f75/retriever/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["kms:Decrypt"],
      "Resource": ["*"],
      "Condition": {
        "StringLike": {
          "aws:InvokedBy": ["qbusiness.amazonaws.com", "qapps.amazonaws.com"]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["qapps:*"],
      "Resource": [
        "arn:aws:qbusiness:us-east-1:905418183804:application/2594236d-712a-4355-8b0e-6a4cef023f75",
        "arn:aws:qapps:us-east-1:905418183804:application/2594236d-712a-4355-8b0e-6a4cef023f75/qapp/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "user-subscriptions:CreateClaim",
        "user-subscriptions:CreateUserClaim"
      ],
      "Resource": ["*"]
    }
  ]
}
