{
  "name": "numa-ops-config-api",
  "packageManager": "yarn@4.9.2",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "devDependencies": {
    "@arcanumai/style": "workspace:*",
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.16.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "clean": "rimraf dist lambda_function.zip",
    "build": "yarn clean && esbuild --bundle --format=esm --platform=node --outdir=dist --out-extension:.js=.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" index.ts",
    "bundle": "yarn build && touch -d $(git log -1 --format=%cd --date format:\"%FT%T\" .) dist/* && zip -X -j lambda_function.zip dist/*",
    "lint": "eslint && tsc --noEmit",
    "test": "echo 'no tests'"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.799.0",
    "@aws-sdk/client-dynamodb": "^3.699.0",
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/lib-dynamodb": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0"
  }
}
