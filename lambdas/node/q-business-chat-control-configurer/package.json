{
  "name": "q-business-chat-control-configurer",
  "packageManager": "yarn@4.7.0",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "devDependencies": {
    "@arcanumai/style": "workspace:*",
    "@aws-sdk/types": "^3.696.0",
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "esbuild": "^0.24.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "clean": "rimraf dist lambda_function.zip",
    "build": "yarn clean && esbuild --bundle --format=esm --platform=node --outdir=dist --out-extension:.js=.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" index.ts",
    "bundle": "yarn build",
    "lint": "eslint && tsc --noEmit",
    "test": "mkdir -p test-reports; node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-reports/test-report.xml"
  },
  "dependencies": {
    "@aws-sdk/client-qbusiness": "^3.699.0"
  }
}
