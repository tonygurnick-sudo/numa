    --start) START_LINE="$2"; shift 2 ;;
    --offset) OFFSET="$2"; shift 2 ;;
    --id) OUTPUT_ID="$2"; shift 2 ;;
    --format) FORMAT="$2"; shift 2 ;;
    --ask) ASK_MODE=true; NATURAL_QUERY="$2"; shift 2 ;;
    --auto) AUTO_MODE=true; shift ;;

    # Engine mode flags
    --engine) ENGINE_NAME="$2"; shift 2 ;;
    --csv) ENGINE_PARAMS[CSV_FILE]="$2"; AUTO_DETECT_ENGINE=true; shift 2 ;;
    --s3) ENGINE_PARAMS[S3_PATH]="$2"; AUTO_DETECT_ENGINE=true; shift 2 ;;
    --parquet) ENGINE_PARAMS[PARQUET_FILE]="$2"; shift 2 ;;
    --json) ENGINE_PARAMS[JSON_FILE]="$2"; shift 2 ;;
    --table) ENGINE_PARAMS[TABLE_NAME]="$2"; shift 2 ;;
    --region) ENGINE_PARAMS[AWS_REGION]="$2"; shift 2 ;;
    --pattern) ENGINE_PARAMS[CSV_PATTERN]="$2"; shift 2 ;;
    --sheet-id) ENGINE_PARAMS[SHEET_ID]="$2"; shift 2 ;;
