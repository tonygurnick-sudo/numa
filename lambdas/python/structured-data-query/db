# Get database schema for natural language context
get_db_schema() {
  {
    echo "=== TABLES ==="
    psql -h "$DB_HOST" -p "$DB_PORT" -d "$DB_NAME" -U "$DB_USER" -t -A -c "\dt" 2>/dev/null | grep '^public' | awk -F'|' '{print $2}'

    echo ""
    echo "=== COLUMNS (table,column,type,nullable,default) ==="
    psql -h "$DB_HOST" -p "$DB_PORT" -d "$DB_NAME" -U "$DB_USER" --csv -t -c "
      SELECT
        c.table_name,
        c.column_name,
        CASE WHEN c.udt_name != c.data_type THEN c.udt_name ELSE c.data_type END as type,
        c.is_nullable,
        c.column_default
      FROM information_schema.columns c
      WHERE c.table_schema = 'public'
      ORDER BY c.table_name, c.ordinal_position;
    " 2>/dev/null

    echo ""
    echo "=== ENUM TYPES ==="
    psql -h "$DB_HOST" -p "$DB_PORT" -d "$DB_NAME" -U "$DB_USER" --csv -t -c "
      SELECT
        t.typname,
        string_agg(e.enumlabel, ', ' ORDER BY e.enumsortorder)
      FROM pg_type t
      JOIN pg_enum e ON t.oid = e.enumtypid
      GROUP BY t.typname
      ORDER BY t.typname;
    " 2>/dev/null
  }
}

# Generate SQL from natural language using Claude API
generate_sql_from_natural_language() {
  local question="$1"
  local schema="$2"  # Schema passed as parameter

  # Check for API key
  if [ -z "$ANTHROPIC_API_KEY" ]; then
    echo "Error: ANTHROPIC_API_KEY environment variable not set"
    echo "Set it with: export ANTHROPIC_API_KEY='your-key-here'"
    return 1
  fi

  # Engine-specific SQL guidance
  local engine_guidance=""
  if [ -n "$ENGINE_NAME" ]; then
    case "$ENGINE_NAME" in
      csv-sqlite|s3-csv-sqlite)
        engine_guidance="
ENGINE: $ENGINE_NAME (SQLite with CSV)
CRITICAL: Query table named 'data' (the CSV is imported as this table)
SYNTAX: Standard SQLite/PostgreSQL syntax
EXAMPLE: SELECT * FROM data WHERE amount > 1000"
        ;;
      csv-duckdb)
        local csv_file_path="${ENGINE_PARAMS[CSV_FILE]}"
        engine_guidance="
ENGINE: csv-duckdb (DuckDB analytics)
TARGET FILE: $csv_file_path
CRITICAL: Use read_csv_auto('$csv_file_path') function - ALWAYS use this exact file path
SYNTAX: SELECT * FROM read_csv_auto('$csv_file_path') WHERE condition
EXAMPLE: SELECT region, SUM(amount) FROM read_csv_auto('$csv_file_path') GROUP BY region"
        ;;
      athena)
        engine_guidance="
ENGINE: AWS Athena
CRITICAL: Use table names from the schema below
SYNTAX: Standard Presto/Athena SQL"
        ;;
    esac
  fi

  # Create system prompt
  local system_prompt="You are a SQL expert. Convert natural language questions into SQL queries.

${engine_guidance:+$engine_guidance

}DATABASE SCHEMA:
$schema

RULES:
- Return ONLY the SQL query, nothing else
- Use proper SQL syntax for the engine specified above
- Limit results to 100 rows by default unless user asks for more
- Use appropriate JOINs and WHERE clauses
${engine_guidance:+- CRITICAL: Follow the engine-specific syntax requirements above}

Example:
User: \"Show me the most recent 10 records\"
Response: SELECT * FROM ${ENGINE_NAME:+data}${ENGINE_NAME:-llm_traces} ORDER BY created_at DESC LIMIT 10;"

  # Escape JSON properly
  local escaped_prompt=$(echo "$system_prompt" | jq -Rs .)
  local escaped_question=$(echo "$question" | jq -Rs .)

  # Use temp file to avoid "Argument list too long" error with large schema
  local request_file=$(mktemp)
  cat > "$request_file" <<EOF
{
  "model": "$SINGLE_QUERY_MODEL",
  "max_tokens": 1024,
  "system": $escaped_prompt,
  "messages": [
    {"role": "user", "content": $escaped_question}
  ]
}
EOF

  # Call Anthropic API (use SINGLE_QUERY_MODEL for non-agentic mode)
  local response=$(curl -s https://api.anthropic.com/v1/messages \
    --header "x-api-key: $ANTHROPIC_API_KEY" \
    --header "anthropic-version: 2023-06-01" \
    --header "content-type: application/json" \
    --data @"$request_file")

  command rm "$request_file" 2>/dev/null || true

  # Extract SQL from response
  local sql=$(echo "$response" | jq -r '.content[0].text' 2>/dev/null)

  if [ -z "$sql" ] || [ "$sql" = "null" ]; then
    echo "Error: Failed to generate SQL" >&2
    echo "Response: $response" >&2
    return 1
  fi

  # Clean up SQL (remove markdown code blocks if present)
  sql=$(echo "$sql" | sed -E 's/^```sql//g' | sed -E 's/^```//g' | sed -E 's/```$//g' | sed -E '/^$/d')

  echo "$sql"
}

# Generate natural language answer from query results
answer_question_from_results() {
  local question="$1"
  local sql_query="$2"
  local query_results="$3"
  local schema="$4"

  # Check for API key
  if [ -z "$ANTHROPIC_API_KEY" ]; then
    echo "Error: ANTHROPIC_API_KEY environment variable not set"
    return 1
  fi

  # Create analysis prompt
  local system_prompt="You are a data analyst helping users understand database query results.

Your task:
1. Analyze the SQL query results in context of the user's original question
2. Provide a clear, concise answer to their question
3. Include relevant numbers, patterns, or insights from the data
4. Be information-dense but easy to understand
5. If the results are empty or unexpected, explain why

Format rules:
- Start directly with the answer (no preamble like 'Based on the data...')
- Support with specific data points
- Keep it concise (2-4 sentences typically)
- Use natural language, not technical jargon
- DO NOT use ** for bold or any other markdown formatting
- DO NOT add concluding statements or summaries at the end
- Just present the facts directly and clearly"

  local user_message="USER'S QUESTION: $question

DATABASE SCHEMA:
$schema

SQL QUERY EXECUTED:
$sql_query

QUERY RESULTS:
$query_results

Please answer the user's question based on these results."

  # Escape JSON properly
  local escaped_prompt=$(echo "$system_prompt" | jq -Rs .)
  local escaped_message=$(echo "$user_message" | jq -Rs .)

  # Use temp file to avoid "Argument list too long" error with large results
  local request_file=$(mktemp)
  cat > "$request_file" <<EOF
{
  "model": "$SINGLE_QUERY_MODEL",
  "max_tokens": 1024,
  "system": $escaped_prompt,
  "messages": [
    {"role": "user", "content": $escaped_message}
  ]
}
EOF

  # Call Anthropic API (use SINGLE_QUERY_MODEL for answer generation)
  local response=$(curl -s https://api.anthropic.com/v1/messages \
    --header "x-api-key: $ANTHROPIC_API_KEY" \
    --header "anthropic-version: 2023-06-01" \
    --header "content-type: application/json" \
    --data @"$request_file")

  command rm "$request_file" 2>/dev/null || true

  # Extract answer from response
  local answer=$(echo "$response" | jq -r '.content[0].text' 2>/dev/null)

  if [ -z "$answer" ] || [ "$answer" = "null" ]; then
    echo "Error: Failed to generate answer" >&2
    return 1
  fi

  echo "$answer"
}

# Parse and store STORE[key] = value from reasoning
parse_and_store() {
  local text="$1"
  # Find all STORE[key] = value patterns (avoid subshell by using process substitution)
  while IFS= read -r store_stmt; do
    if [ -n "$store_stmt" ]; then
      local key=$(echo "$store_stmt" | sed -E 's/STORE\[([a-zA-Z0-9_]+)\].*/\1/')
      local value=$(echo "$store_stmt" | sed -E 's/STORE\[[a-zA-Z0-9_]+\][[:space:]]*=[[:space:]]*//' | sed 's/[,;.]$//')
      if [ -n "$key" ] && [ -n "$value" ]; then
        AGENT_STORE["$key"]="$value"
        echo "  [STORED] $key = $value" >&2
      fi
    fi
  done < <(echo "$text" | grep -oE 'STORE\[[a-zA-Z0-9_]+\][[:space:]]*=[[:space:]]*[^,;.()]+')
}

# Replace RECALL[key] with stored values
process_recalls() {
  local text="$1"
  local result="$text"

  # Find all RECALL[key] patterns and replace with stored values
  for key in "${!AGENT_STORE[@]}"; do
    local value="${AGENT_STORE[$key]}"
    result=$(echo "$result" | sed "s/RECALL\[$key\]/$value/g")
  done

  echo "$result"
}

# Display current agent store
display_store() {
  if [ ${#AGENT_STORE[@]} -eq 0 ]; then
    return
  fi

  echo ""
  echo "AGENT MEMORY (Key-Value Store):"
  echo "─────────────────────────────────────────────────────────────────────────────"
  for key in "${!AGENT_STORE[@]}"; do
    echo "  $key = ${AGENT_STORE[$key]}"
  done
  echo "─────────────────────────────────────────────────────────────────────────────"
  echo ""
}

