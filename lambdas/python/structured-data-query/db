# Process output to truncate large result sets for LLM efficiency
process_output() {
  local tmpfile=$(mktemp)
  local cleaned=$(mktemp)

  # Read all input into tmpfile
  cat > "$tmpfile"

  # Clean up excessive whitespace to save tokens
  # Remove lines that are >80% whitespace/dashes, and compress multiple blank lines to max 2
  awk '
    {
      # Count non-whitespace chars
      test = $0
      gsub(/[[:space:]-]/, "", test)
      non_ws = length(test)
      total = length($0)

      # Skip lines that are mostly whitespace/dashes (>100 chars and >80% whitespace)
      if (total > 100 && non_ws < total * 0.2) {
        next
      }

      # Compress multiple blank lines to max 2
      if (length($0) == 0) {
        blank_count++
        if (blank_count <= 2) print
      } else {
        blank_count = 0
        print
      }
    }
  ' "$tmpfile" > "$cleaned"

  # Replace tmpfile with cleaned version
  command mv "$cleaned" "$tmpfile"

  # Check file size first (hard limit)
  local file_size=$(stat -f%z "$tmpfile" 2>/dev/null || stat -c%s "$tmpfile" 2>/dev/null)

  if [ "$file_size" -gt "$MAX_BYTES" ] && [ "$VERBOSE" = false ]; then
    local uuid=$(cat /proc/sys/kernel/random/uuid | cut -d'-' -f1)
    local cache_file="/tmp/db_output_$uuid"
    cp "$tmpfile" "$cache_file" 2>/dev/null
    command rm "$tmpfile" 2>/dev/null || true

    local size_kb=$((file_size / 1024))
    local limit_kb=$((MAX_BYTES / 1024))
    echo "ERROR: Response is too large (${size_kb}KB exceeds ${limit_kb}KB limit)"
    echo ""
    echo "The query returned too much data for efficient token usage."
    echo "Output has been cached with ID: $uuid"
    echo ""
    echo "Options:"
    echo "  1. Refine your query to return less data (recommended)"
    echo "  2. Use: db --id $uuid --start 1 --offset 100 (paginate)"
    echo "  3. Use: db --verbose [query] (see all, may consume many tokens)"
    echo ""
    return
  fi

  # Count lines
  local total_lines=$(wc -l < "$tmpfile")

  # Verbose mode - show everything
  if [ "$VERBOSE" = true ]; then
    cat "$tmpfile"
    command rm "$tmpfile" 2>/dev/null || true
    return
  fi

  # Small output - show everything
  if [ "$total_lines" -le "$THRESHOLD" ]; then
    cat "$tmpfile"
    command rm "$tmpfile" 2>/dev/null || true
    return
  fi

  # Large output - truncate and cache
  # Generate short UUID for reference
  local uuid=$(cat /proc/sys/kernel/random/uuid | cut -d'-' -f1)
  local cache_file="/tmp/db_output_$uuid"

  # Save full output to cache
  cp "$tmpfile" "$cache_file" 2>/dev/null

  # Show truncated output
  head -n "$HEAD_LINES" "$tmpfile"
  local omitted=$((total_lines - HEAD_LINES - TAIL_LINES))
  echo ""
  echo "... [$omitted lines omitted] ..."
  echo "Output ID: $uuid"
  echo "TIP: Use --verbose to see all $total_lines lines"
  echo "     Or: db-v1 --id $uuid --start 201 --offset 100"
  echo ""
  tail -n "$TAIL_LINES" "$tmpfile"

  # Cleanup tmpfile
  command rm "$tmpfile" 2>/dev/null || true
}

