#!/bin/bash
# Supabase Database CLI - Version 4.0 (Development - 2025-10-28)
# Simple tool for running SQL queries against the Supabase database
#
# Version 4.0 Features (NEW):
# - Agentic investigation mode via --ask --auto
# - Multi-hop reasoning with iterative query refinement
# - Claude conducts full investigation workflow autonomously
# - Accumulates evidence across multiple queries
# - Adaptive decision-making based on intermediate results
# - Engine system for ad-hoc datasources (CSV, S3, etc.)
# - Configuration file support
#
# Version 2.0 Features:
# - Natural language SQL via --ask flag
# - Uses Claude API to convert English to SQL
# - Auto-includes database schema in context
#
# Version 1.0 Features:
# - Auto-truncation of large outputs (10KB limit)
# - Whitespace cleanup for token efficiency
# - UUID-based pagination for large results
# - Multiple output formats (table, csv, json)
#
# SETUP: To use 'db' command from anywhere, create a symlink:
#   ln -sf /home/ubuntu/app/backend/scripts/db ~/.local/bin/db
#
# REQUIREMENTS:
#   - Set ANTHROPIC_API_KEY environment variable for --ask
#   - Create .env file from .env.example for database credentials

# Load environment variables from .env file if it exists
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/.env" ]; then
  source "$SCRIPT_DIR/.env"
  echo "✓ Loaded environment from .env" >&2
fi

# PostgreSQL connection details (loaded from environment)
# These are only required if using PostgreSQL datasource
# For engine mode (--engine), different credentials may be needed

# Validate PostgreSQL environment variables if they're being used
validate_postgres_env() {
  local required_vars=("DB_HOST" "DB_PORT" "DB_NAME" "DB_USER" "DB_PASSWORD")
  local missing_vars=()

  for var in "${required_vars[@]}"; do
    if [ -z "${!var}" ]; then
      missing_vars+=("$var")
    fi
  done

  if [ ${#missing_vars[@]} -gt 0 ]; then
    echo "Error: Required PostgreSQL environment variables not set:" >&2
    printf '  - %s\n' "${missing_vars[@]}" >&2
    echo "" >&2
    echo "Create a .env file from the example:" >&2
    echo "  cp .env.example .env" >&2
    echo "Then edit .env and add your credentials" >&2
    return 1
  fi

  # Set PGPASSWORD for psql
  export PGPASSWORD="$DB_PASSWORD"
  return 0
}

# Datasource configuration
DATASOURCE_NAME=""  # Named datasource from config.engines.yaml
CONFIG_FILE="$SCRIPT_DIR/config.engines.yaml"

# Load datasource from config.engines.yaml
load_datasource() {
  local datasource_name="$1"

  if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Config file not found: $CONFIG_FILE" >&2
    echo "Create config.engines.yaml from the example" >&2
    return 1
  fi

  # Check if yq is available (YAML parser)
  if ! command -v yq &> /dev/null; then
    echo "Error: yq is required for --datasource functionality" >&2
    echo "Install with: sudo wget https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 -O /usr/bin/yq && sudo chmod +x /usr/bin/yq" >&2
    return 1
  fi

  # Get datasource config
  local datasource_type=$(yq eval ".datasources.$datasource_name.type" "$CONFIG_FILE")

  if [ "$datasource_type" == "null" ] || [ -z "$datasource_type" ]; then
    echo "Error: Datasource '$datasource_name' not found in $CONFIG_FILE" >&2
    echo "" >&2
    echo "Available datasources:" >&2
    yq eval '.datasources | keys | .[]' "$CONFIG_FILE" 2>/dev/null | sed 's/^/  - /' >&2
    return 1
  fi

  echo "✓ Loading datasource: $datasource_name (type: $datasource_type)" >&2

  # Load connection environment variable names from config
  local host_env=$(yq eval ".datasources.$datasource_name.connection.host_env" "$CONFIG_FILE")
  local port_env=$(yq eval ".datasources.$datasource_name.connection.port_env" "$CONFIG_FILE")
  local database_env=$(yq eval ".datasources.$datasource_name.connection.database_env" "$CONFIG_FILE")
  local user_env=$(yq eval ".datasources.$datasource_name.connection.user_env" "$CONFIG_FILE")
  local password_env=$(yq eval ".datasources.$datasource_name.connection.password_env" "$CONFIG_FILE")

  # Set DB_* variables from the environment variables specified in config
  if [ "$host_env" != "null" ] && [ -n "${!host_env}" ]; then
    export DB_HOST="${!host_env}"
  fi

  if [ "$port_env" != "null" ] && [ -n "${!port_env}" ]; then
    export DB_PORT="${!port_env}"
  fi

  if [ "$database_env" != "null" ] && [ -n "${!database_env}" ]; then
    export DB_NAME="${!database_env}"
  fi

  if [ "$user_env" != "null" ] && [ -n "${!user_env}" ]; then
    export DB_USER="${!user_env}"
  fi

  if [ "$password_env" != "null" ] && [ -n "${!password_env}" ]; then
    export DB_PASSWORD="${!password_env}"
    export PGPASSWORD="$DB_PASSWORD"
  fi

  return 0
}

# Output processing defaults (optimized for LLM token usage)
VERBOSE=false
START_LINE=0
OFFSET=100
OUTPUT_ID=""
FORMAT="csv"  # csv (default), table, json
HEAD_LINES=200
TAIL_LINES=200
THRESHOLD=400
