# Execute query with format options
run_query() {
  local query="$1"

  case "$FORMAT" in
    csv)
      psql -h "$DB_HOST" -p "$DB_PORT" -d "$DB_NAME" -U "$DB_USER" --csv -c "$query"
      ;;
    json)
      # Strip trailing semicolon and wrap query in JSON aggregation
      local clean_query="${query%;}"
      local json_query="SELECT json_agg(row_to_json(t)) FROM ($clean_query) t;"
      psql -h "$DB_HOST" -p "$DB_PORT" -d "$DB_NAME" -U "$DB_USER" -t -A -c "$json_query"
      ;;
    table|*)
      psql -h "$DB_HOST" -p "$DB_PORT" -d "$DB_NAME" -U "$DB_USER" -c "$query"
      ;;
  esac
}

