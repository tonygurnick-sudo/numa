# Execute csv-sqlite engine
execute_csv_sqlite_engine() {
  local query="$1"
  local csv_input="${ENGINE_PARAMS[CSV_FILE]}"
  local table_name="${ENGINE_PARAMS[TABLE_NAME]:-data}"

  if [ -z "$csv_input" ]; then
    echo "Error: --csv parameter required for csv-sqlite engine" >&2
    echo "Usage: db --engine csv-sqlite --csv <file|url> \"SQL QUERY\"" >&2
    echo "Examples:" >&2
    echo "  db --engine csv-sqlite --csv ./data.csv \"SELECT * FROM data\"" >&2
    echo "  db --engine csv-sqlite --csv https://example.com/data.csv \"SELECT * FROM data\"" >&2
    exit 1
  fi

  local csv_file="$csv_input"
  local downloaded=false

  # Check if input is a URL
  if [[ "$csv_input" =~ ^https?:// ]]; then
    # Create cache directory
    local cache_dir="$HOME/.cache/db-cli"
    mkdir -p "$cache_dir"

    # Generate cache filename from URL hash
    local url_hash=$(echo -n "$csv_input" | md5sum | cut -d' ' -f1)
    local cached_file="$cache_dir/csv_${url_hash}.csv"

    # Check if cached version exists and is less than 1 hour old
    if [ -f "$cached_file" ] && [ $(($(date +%s) - $(stat -c %Y "$cached_file" 2>/dev/null || stat -f %m "$cached_file" 2>/dev/null))) -lt 3600 ]; then
      echo "Using cached CSV (downloaded < 1 hour ago)" >&2
      csv_file="$cached_file"
    else
      echo "Downloading CSV from URL: $csv_input ..." >&2
      curl -L -f -s "$csv_input" -o "$cached_file"

      if [ $? -ne 0 ]; then
        echo "Error: Failed to download CSV from URL: $csv_input" >&2
        rm -f "$cached_file"
        exit 1
      fi
      csv_file="$cached_file"
      echo "Cached for future use (1 hour)" >&2
    fi
    downloaded=false  # Don't delete cached file
  else
    # Local file - check if it exists
    if [ ! -f "$csv_file" ]; then
      echo "Error: CSV file not found: $csv_file" >&2
      exit 1
    fi
  fi

  # Create temp database
  local temp_db="/tmp/db_cli_$$.sqlite"

  echo "Importing CSV to SQLite..." >&2

  # Import CSV to SQLite
  sqlite3 "$temp_db" <<EOF
.mode csv
.import $csv_file $table_name
EOF

  if [ $? -ne 0 ]; then
    echo "Error: Failed to import CSV to SQLite" >&2
    rm -f "$temp_db"
    [ "$downloaded" = true ] && rm -f "$csv_file"
    exit 1
  fi

  # Execute query with format
  case "$FORMAT" in
    json)
      sqlite3 -json "$temp_db" "$query"
      ;;
    table)
      sqlite3 -table "$temp_db" "$query"
      ;;
    csv|*)
      sqlite3 -csv "$temp_db" "$query"
      ;;
  esac
  local exit_code=$?

  # Cleanup
  rm -f "$temp_db"
  [ "$downloaded" = true ] && rm -f "$csv_file"

  return $exit_code
}

# Execute s3-csv-sqlite engine
execute_s3_csv_sqlite_engine() {
  local query="$1"
  local s3_path="${ENGINE_PARAMS[S3_PATH]}"
  local table_name="${ENGINE_PARAMS[TABLE_NAME]:-data}"
  local region="${ENGINE_PARAMS[AWS_REGION]:-us-east-1}"

  if [ -z "$s3_path" ]; then
    echo "Error: --s3 parameter required for s3-csv-sqlite engine" >&2
    echo "Usage: db --engine s3-csv-sqlite --s3 s3://bucket/file.csv \"SQL QUERY\"" >&2
    exit 1
  fi

  local temp_csv="/tmp/db_cli_$$.csv"
  local temp_db="/tmp/db_cli_$$.sqlite"

  # Download from S3
  echo "Downloading from S3: $s3_path ..." >&2
  aws s3 cp "$s3_path" "$temp_csv" --region "$region" 2>&1 | head -5 >&2

  if [ $? -ne 0 ]; then
    echo "Error: Failed to download from S3: $s3_path" >&2
    rm -f "$temp_csv"
    exit 1
  fi

  # Import to SQLite
  echo "Importing to SQLite..." >&2
  sqlite3 "$temp_db" <<EOF
.mode csv
.import $temp_csv $table_name
EOF

  if [ $? -ne 0 ]; then
    echo "Error: Failed to import CSV to SQLite" >&2
    rm -f "$temp_csv" "$temp_db"
    exit 1
  fi

  # Execute query with format
  case "$FORMAT" in
    json)
      sqlite3 -json "$temp_db" "$query"
      ;;
    table)
      sqlite3 -table "$temp_db" "$query"
      ;;
    csv|*)
      sqlite3 -csv "$temp_db" "$query"
      ;;
  esac
  local exit_code=$?

  # Cleanup
  rm -f "$temp_csv" "$temp_db"

  return $exit_code
}

# Execute csv-duckdb engine (fast analytical queries)
execute_csv_duckdb_engine() {
  local query="$1"
  local csv_file="${ENGINE_PARAMS[CSV_FILE]}"

  if [ -z "$csv_file" ]; then
    echo "Error: --csv parameter required for csv-duckdb engine" >&2
    echo "Usage: db --engine csv-duckdb --csv <file> \"SQL QUERY\"" >&2
    exit 1
  fi

  if [ ! -f "$csv_file" ]; then
    echo "Error: CSV file not found: $csv_file" >&2
    exit 1
  fi

  # Check if duckdb is installed
  if ! command -v duckdb &> /dev/null; then
    echo "Error: duckdb not installed" >&2
    echo "Install with: brew install duckdb (macOS) or visit https://duckdb.org/docs/installation/" >&2
    exit 1
  fi

  echo "Querying CSV with DuckDB..." >&2

  # DuckDB can query CSV files directly
  # Replace {{CSV_FILE}} placeholder in query with actual file path
  local duckdb_query="${query//\{\{CSV_FILE\}\}/$csv_file}"

  # Execute with format
  case "$FORMAT" in
    json)
      duckdb -json << EOF
$duckdb_query
EOF
      ;;
    table)
      duckdb << EOF
$duckdb_query
EOF
      ;;
    csv|*)
      duckdb -csv << EOF
$duckdb_query
EOF
      ;;
  esac
}

# Execute athena engine (serverless S3 SQL queries)
execute_athena_engine() {
  local query="$1"
  local database="${ENGINE_PARAMS[ATHENA_DATABASE]}"
  local workgroup="${ENGINE_PARAMS[ATHENA_WORKGROUP]:-primary}"
  local output_location="${ENGINE_PARAMS[ATHENA_OUTPUT]}"
  local region="${ENGINE_PARAMS[AWS_REGION]:-us-east-1}"

  if [ -z "$database" ]; then
    echo "Error: --athena-db parameter required for athena engine" >&2
    echo "Usage: db --engine athena --athena-db <database> --athena-output s3://bucket/path/ \"SQL QUERY\"" >&2
    exit 1
  fi

  if [ -z "$output_location" ]; then
    echo "Error: --athena-output parameter required (S3 path for query results)" >&2
    echo "Example: db --engine athena --athena-db mydb --athena-output s3://my-bucket/athena-results/ \"SELECT * FROM table\"" >&2
    exit 1
  fi

  # Check if AWS CLI is available
  if ! command -v aws &> /dev/null; then
    echo "Error: AWS CLI not installed" >&2
    echo "Install with: sudo apt-get install awscli" >&2
    exit 1
  fi

  echo "Submitting query to Athena (database: $database)..." >&2

  # Start query execution
  local query_id=$(aws athena start-query-execution \
    --query-string "$query" \
    --query-execution-context Database="$database" \
    --result-configuration OutputLocation="$output_location" \
    --work-group "$workgroup" \
    --region "$region" \
    --output text \
    --query 'QueryExecutionId')

  if [ $? -ne 0 ] || [ -z "$query_id" ]; then
    echo "Error: Failed to submit query to Athena" >&2
    exit 1
  fi

  echo "Query ID: $query_id" >&2
  echo "Waiting for query to complete..." >&2

  # Poll for completion
  local max_attempts=60
  local attempt=0
  local status=""

  while [ $attempt -lt $max_attempts ]; do
    status=$(aws athena get-query-execution \
      --query-execution-id "$query_id" \
      --region "$region" \
      --output text \
      --query 'QueryExecution.Status.State')

    case "$status" in
      SUCCEEDED)
        echo "Query completed successfully!" >&2
        break
        ;;
      FAILED|CANCELLED)
        local reason=$(aws athena get-query-execution \
          --query-execution-id "$query_id" \
          --region "$region" \
          --output text \
          --query 'QueryExecution.Status.StateChangeReason')
        echo "Error: Query $status: $reason" >&2
        exit 1
        ;;
      RUNNING|QUEUED)
        sleep 1
        attempt=$((attempt + 1))
        ;;
    esac
  done

  if [ "$status" != "SUCCEEDED" ]; then
    echo "Error: Query timeout after ${max_attempts} seconds" >&2
    exit 1
  fi

  # Get results based on format
  case "$FORMAT" in
    json)
      # Get results as JSON
      aws athena get-query-results \
        --query-execution-id "$query_id" \
        --region "$region" \
        --output json \
        --query 'ResultSet.Rows'
      ;;
    table)
      # Get results and format as table (using CSV then column for alignment)
      aws athena get-query-results \
        --query-execution-id "$query_id" \
        --region "$region" \
        --output text \
        --query 'ResultSet.Rows[*].Data[*].VarCharValue' | \
        awk '{for(i=1;i<=NF;i++) printf "%s%s", $i, (i<NF?",":"\n")}' | \
        column -t -s ','
      ;;
    csv|*)
      # Get results as CSV (default)
      aws athena get-query-results \
        --query-execution-id "$query_id" \
        --region "$region" \
        --output text \
        --query 'ResultSet.Rows[*].Data[*].VarCharValue' | \
        awk '{for(i=1;i<=NF;i++) printf "%s%s", $i, (i<NF?",":"\n")}'
      ;;
  esac
}

# Main engine dispatcher
execute_engine() {
  local engine_name="$1"
  local query="$2"

  case "$engine_name" in
    csv-sqlite)
      execute_csv_sqlite_engine "$query"
      ;;
    s3-csv-sqlite)
      execute_s3_csv_sqlite_engine "$query"
      ;;
    csv-duckdb)
      execute_csv_duckdb_engine "$query"
      ;;
    athena)
      execute_athena_engine "$query"
      ;;
    *)
      echo "Error: Unknown engine: $engine_name" >&2
      echo "" >&2
      echo "Available engines:" >&2
      echo "  csv-sqlite       - Query local CSV files via SQLite (DEFAULT)" >&2
      echo "  s3-csv-sqlite    - Query S3 CSV files via SQLite (download first)" >&2
      echo "  csv-duckdb       - Query local CSV files via DuckDB (fast analytics)" >&2
      echo "  athena           - Query S3 data using AWS Athena (serverless)" >&2
      echo "" >&2
      echo "Example: db --csv ./data.csv \"SELECT * FROM data\"" >&2
      echo "         db --engine csv-duckdb --csv ./big-data.csv \"SELECT * FROM read_csv_auto('./big-data.csv')\"" >&2
      exit 1
      ;;
  esac
}

# Get schema for engine-based datasources
get_engine_schema() {
  local engine_name="$1"

  case "$engine_name" in
    csv-sqlite|s3-csv-sqlite)
      local csv_file="${ENGINE_PARAMS[CSV_FILE]}"
      local table_name="${ENGINE_PARAMS[TABLE_NAME]:-data}"
      local temp_csv=""

      # Check if input is a URL (http:// or https://)
      if [[ "$csv_file" =~ ^https?:// ]]; then
        # Create cache directory
        local cache_dir="$HOME/.cache/db-cli"
        mkdir -p "$cache_dir"

        # Generate cache filename from URL hash
        local url_hash=$(echo -n "$csv_file" | md5sum | cut -d' ' -f1)
        local cached_file="$cache_dir/csv_${url_hash}.csv"

        # Check if cached version exists and is less than 1 hour old
        if [ -f "$cached_file" ] && [ $(($(date +%s) - $(stat -c %Y "$cached_file"))) -lt 3600 ]; then
          echo "Using cached CSV for schema (downloaded < 1 hour ago)" >&2
          csv_file="$cached_file"
        else
          echo "Downloading CSV for schema from URL: $csv_file ..." >&2
          if curl -L -f -s "$csv_file" -o "$cached_file"; then
            echo "Cached for future use (1 hour)" >&2
            csv_file="$cached_file"
          else
            echo "Error: Failed to download CSV from URL" >&2
            return 1
          fi
        fi
      elif [ "$engine_name" = "s3-csv-sqlite" ]; then
        # For S3, we need to download first
        local s3_path="${ENGINE_PARAMS[S3_PATH]}"
        local region="${ENGINE_PARAMS[AWS_REGION]:-us-east-1}"
        temp_csv="/tmp/db_cli_schema_$$.csv"

        echo "Downloading schema from S3..." >&2
        aws s3 cp "$s3_path" "$temp_csv" --region "$region" >&2
        csv_file="$temp_csv"
      fi

      local temp_db="/tmp/db_cli_schema_$$.sqlite"

      # Import and get schema
      sqlite3 "$temp_db" <<EOF
.mode csv
.import $csv_file $table_name
.schema $table_name
SELECT 'Sample data:';
SELECT * FROM $table_name LIMIT 5;
EOF

      # Cleanup
      rm -f "$temp_db" "$temp_csv" 2>/dev/null
      ;;
    *)
      echo "Schema inspection not yet implemented for engine: $engine_name" >&2
      ;;
  esac
}

