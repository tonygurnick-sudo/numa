    --athena-output) ENGINE_PARAMS[ATHENA_OUTPUT]="$2"; shift 2 ;;
    --athena-workgroup) ENGINE_PARAMS[ATHENA_WORKGROUP]="$2"; shift 2 ;;

    # Datasource flag (named datasource from config.engines.yaml)
    --datasource) DATASOURCE_NAME="$2"; shift 2 ;;

    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

# Load datasource if specified
if [ -n "$DATASOURCE_NAME" ]; then
  load_datasource "$DATASOURCE_NAME" || exit 1
fi

# Auto-detect engine if not explicitly specified
if [ "$AUTO_DETECT_ENGINE" = true ] && [ -z "$ENGINE_NAME" ]; then
  if [ -n "${ENGINE_PARAMS[CSV_FILE]}" ]; then
    ENGINE_NAME="csv-sqlite"
    echo "Auto-detected engine: csv-sqlite (use --engine csv-duckdb for 10-100x faster performance on large files)" >&2
  elif [ -n "${ENGINE_PARAMS[S3_PATH]}" ]; then
