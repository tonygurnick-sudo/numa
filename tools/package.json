{
  "name": "@arcanumai/q-apps-deployer-tools",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "dependencies": {
    "@arcanumai/client-config": "workspace:^",
    "@aws-sdk/client-cognito-identity-provider": "^3.675.0",
    "@aws-sdk/client-qbusiness": "^3.675.0",
    "@aws-sdk/client-s3": "^3.676.0",
    "@aws-sdk/client-service-quotas": "^3.738.0",
    "@aws-sdk/client-support": "^3.738.0",
    "@aws-sdk/credential-providers": "^3.679.0",
    "@aws-sdk/lib-storage": "^3.676.0",
    "adm-zip": "^0.5.16",
    "chalk": "^5.3.0",
    "commander": "^13.0.0",
    "csv": "^6.3.10",
    "generate-password": "^1.7.1",
    "inquirer": "^12.0.0",
    "json-diff-ts": "^4.3.0",
    "playwright": "^1.48.1",
    "tsx": "^4.19.1"
  },
  "scripts": {
    "build": "tsc",
    "check-bedrock-cases": "node --import tsx check-bedrock-cases.ts",
    "check-index-progress": "node --import tsx check-index-progress.ts",
    "create-users": "node --import tsx create-users.ts",
    "delete-users": "node --import tsx delete-users.ts",
    "downgrade-licences": "node --import tsx downgrade-licences.ts",
    "lint": "eslint . && tsc --noEmit",
    "test": "mkdir -p test-reports; node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-reports/test-report.xml",
    "upload-files": "node --import tsx upload-files.ts",
    "check-email-cases": "node --import tsx check-email-cases.ts",
    "check-email-verified": "node --import tsx check-email-verified.ts",
    "check-user-password-state": "node --import tsx check-user-password-state.ts",
    "retrieve-config": "node --import tsx retrieve-config.ts",
    "write-config": "node --import tsx write-config.ts",
    "delete-config": "node --import tsx delete-config.ts",
    "list-clients": "node --import tsx list-clients.ts"
  },
  "packageManager": "yarn@4.9.2",
  "devDependencies": {
    "@arcanumai/style": "workspace:*",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3"
  }
}
