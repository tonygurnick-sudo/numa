    "nolia-assessments": "node --import tsx nolia-assessments.ts",
    "nolia-rules-gen": "node --import tsx nolia-rules-gen.ts",
    "assign-bedrock-quota-sharing": "node --import tsx assign-bedrock-quota-sharing.ts",
