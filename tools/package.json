  "devDependencies": {
    "@arcanumai/style": "workspace:*",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3"
  }
