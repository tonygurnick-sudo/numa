{
  "name": "@numa/cli-workspace",
  "version": "0.1.0",
  "description": "Numa CLI workspace root — coordinates @numa/cli (prod) and @numa/cli-dev (dev addon). Source lives under packages/.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --from '@numa/cli-dev' --recursive --topological-dev run build",
    "typecheck": "yarn workspaces foreach --from '@numa/cli-dev' --recursive run typecheck",
    "clean": "yarn workspaces foreach --from '@numa/cli-dev' --recursive run clean"
  }
}
