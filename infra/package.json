{
  "name": "@arcanumai/q-apps-deployer-infra",
  "version": "1.0.0",
  "main": "main.ts",
  "types": "main.ts",
  "type": "module",
  "license": "MPL-2.0",
  "private": true,
  "scripts": {
    "get": "cdktf get",
    "build": "tsc",
    "lint": "eslint . && tsc --noEmit",
    "synth": "cdktf synth",
    "compile": "tsc --pretty",
    "test": "tsx --test",
    "cdktf": "mkdir -p cdktf.out && AWS_PROFILE=default AWS_CLIENT_PROFILE=arcanum-q-deployer-${TF_ENVIRONMENT} CDKTF_OUTPUT=cdktf.out/${TF_ENVIRONMENT} cdktf"
  },
  "engines": {
    "node": ">=20.0"
  },
  "dependencies": {
    "@arcanumai/cdktf-util": "^1.14.0",
    "@arcanumai/private-bucket-construct": "^1.2.1",
    "@arcanumai/typescript-lambda-construct": "^1.2.4",
    "@aws-sdk/client-service-quotas": "^3.734.0",
    "@cdktf/provider-aws": "^19.42.0",
    "@cdktf/provider-random": "^11.0.3",
    "asl-types": "^1.2.1",
    "cdktf": "~0.20.0",
    "constructs": "~10",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@cdktf/node-pty-prebuilt-multiarch": "^0.10.1-pre.11",
    "@types/fs-extra": "^11",
    "@types/node": "22.10.2",
    "@typescript-eslint/eslint-plugin": "8.22.0",
    "@typescript-eslint/parser": "8.22.0",
    "cdktf-cli": "0.20.10",
    "eslint": "9.19.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.1",
    "fs-extra": "^11.2.0",
    "prettier": "3.4.2",
    "tsx": "^4.19.0",
    "typescript": "5.7.2"
  },
  "packageManager": "yarn@4.6.0"
}
