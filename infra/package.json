{
  "name": "@arcanumai/q-apps-deployer-infra",
  "version": "1.0.0",
  "main": "main.ts",
  "types": "main.ts",
  "type": "module",
  "license": "MPL-2.0",
  "private": true,
  "scripts": {
    "get": "cdktf get",
    "build": "tsc",
    "lint": "eslint --ignore-path ../.gitignore . && tsc --noEmit",
    "synth": "cdktf synth",
    "compile": "tsc --pretty",
    "test": "tsx --test",
    "cdktf": "mkdir -p cdktf.out && AWS_PROFILE=default AWS_CLIENT_PROFILE=arcanum-q-deployer-${TF_ENVIRONMENT} CDKTF_OUTPUT=cdktf.out/${TF_ENVIRONMENT} cdktf"
  },
  "engines": {
    "node": ">=20.0"
  },
  "dependencies": {
    "@arcanumai/cdktf-util": "^1.13.0",
    "@arcanumai/private-bucket-construct": "^1.2.1",
    "@arcanumai/typescript-lambda-construct": "^1.2.4",
    "@cdktf/provider-aws": "^19.36.0",
    "cdktf": "~0.20.0",
    "constructs": "~10"
  },
  "devDependencies": {
    "@cdktf/node-pty-prebuilt-multiarch": "^0.10.1-pre.11",
    "@types/fs-extra": "^11",
    "@types/node": "22.8.6",
    "@typescript-eslint/eslint-plugin": "8.12.2",
    "@typescript-eslint/parser": "8.12.2",
    "cdktf-cli": "0.20.9",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "fs-extra": "^11.2.0",
    "prettier": "3.3.3",
    "tsx": "^4.19.0",
    "typescript": "5.6.3"
  },
  "packageManager": "yarn@4.5.0"
}
