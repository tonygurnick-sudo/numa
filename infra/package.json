{
  "name": "@arcanumai/q-apps-deployer-infra",
  "version": "1.0.0",
  "main": "main.ts",
  "types": "main.ts",
  "type": "module",
  "license": "MPL-2.0",
  "private": true,
  "scripts": {
    "get": "cdktf get",
    "build": "tsc",
    "lint": "eslint . && tsc --noEmit",
    "synth": "cdktf synth",
    "compile": "tsc --pretty",
    "test": "mkdir -p test-reports; tsx --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-reports/test-report.xml",
    "cdktf": "mkdir -p cdktf.out && AWS_PROFILE=default AWS_CLIENT_PROFILE=arcanum-q-deployer-prod CDKTF_OUTPUT=cdktf.out/prod cdktf"
  },
  "engines": {
    "node": ">=20.0"
  },
  "dependencies": {
    "@arcanumai/cdktf-util": "^1.14.0",
    "@arcanumai/client-config": "workspace:^",
    "@arcanumai/private-bucket-construct": "^1.2.1",
    "@arcanumai/typescript-lambda-construct": "^1.2.4",
    "@aws-sdk/client-service-quotas": "^3.738.0",
    "@aws-sdk/client-support": "^3.738.0",
    "@aws-sdk/credential-providers": "^3.880.0",
    "@cdktf/provider-aws": "21.1.0",
    "@cdktf/provider-random": "12.0.0",
    "asl-types": "^1.2.1",
    "cdktf": "0.21.0",
    "constructs": "~10",
    "eslint": "^9.20.1",
    "uuid": "^11.0.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@arcanumai/style": "workspace:*",
    "@cdktf/node-pty-prebuilt-multiarch": "^0.10.1-pre.11",
    "@types/fs-extra": "^11",
    "@types/node": "22.17.2",
    "@typescript-eslint/eslint-plugin": "8.41.0",
    "@typescript-eslint/parser": "8.41.0",
    "cdktf-cli": "0.21.0",
    "fs-extra": "^11.2.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.2"
  },
  "packageManager": "yarn@4.9.2"
}
