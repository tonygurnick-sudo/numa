{
  "name": "@arcanumai/q-apps-deployer-infra",
  "version": "1.0.0",
  "main": "main.ts",
  "types": "main.ts",
  "type": "module",
  "license": "MPL-2.0",
  "private": true,
  "scripts": {
    "get": "cdktf get",
    "build": "tsc",
    "lint": "eslint --ignore-path ../.gitignore . && tsc --noEmit",
    "synth": "cdktf synth",
    "compile": "tsc --pretty",
    "test": "tsx --test",
    "cdktf": "mkdir -p cdktf.out && AWS_PROFILE=default AWS_CLIENT_PROFILE=arcanum-q-deployer-${TF_ENVIRONMENT} CDKTF_OUTPUT=cdktf.out/${TF_ENVIRONMENT} cdktf"
  },
  "engines": {
    "node": ">=20.0"
  },
  "dependencies": {
    "@arcanumai/cdktf-util": "1.11.0",
    "@cdktf/provider-aws": "~19.8.0",
    "cdktf": "~0.20.0",
    "constructs": "~10"
  },
  "devDependencies": {
    "@cdktf/node-pty-prebuilt-multiarch": "^0.10.1-pre.11",
    "@types/fs-extra": "^11",
    "@types/node": "20.11.24",
    "@typescript-eslint/eslint-plugin": "7.1.0",
    "@typescript-eslint/parser": "7.1.0",
    "cdktf-cli": "0.20.4",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "fs-extra": "^11.2.0",
    "prettier": "3.2.5",
    "tsx": "^4.19.0",
    "typescript": "5.3.3"
  },
  "packageManager": "yarn@4.4.1"
}
