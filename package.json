{
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "style",
    "infra",
    "tools",
    "numa-cli",
    "numa-frontend",
    "numa-customer-success-portal",
    "lib/client-config-node",
    "lib/usage-analytics-schemas",
    "lambdas/node/*"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\" --ignore-path .gitignore",
    "lint": "yarn workspaces foreach --parallel --all run lint",
    "lint:fix": "yarn workspaces foreach --parallel --all run lint --fix",
    "setup": "which pre-commit >/dev/null 2>&1 && (pre-commit install && echo '✅ Pre-commit hooks installed successfully!') || (echo '⚠️  Pre-commit not found. Install it with:' && echo '   pip install pre-commit' && echo '   yarn setup' && echo '' && echo 'Or with homebrew:' && echo '   brew install pre-commit' && echo '   yarn setup')",
    "postinstall": "yarn setup"
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "es5",
    "tabWidth": 2,
    "useTabs": false
  }
}
