{
  "name": "Update Solution Article",
  "description": "Update a solution article in Freshdesk. [See the documentation](https://developers.freshdesk.com/api/#solution_article_attributes)",
  "component_type": "action",
  "version": "0.0.4",
  "key": "freshdesk-update-solution-article",
  "annotations": {
    "readOnlyHint": false,
    "openWorldHint": true,
    "destructiveHint": true
  },
  "configurable_props": [
    {
      "name": "freshdesk",
      "type": "app",
      "app": "freshdesk"
    },
    {
      "name": "categoryId",
      "type": "integer",
      "label": "Category ID",
      "description": "The ID of a category",
      "remoteOptions": true
    },
    {
      "name": "folderId",
      "type": "integer",
      "label": "Folder ID",
      "description": "The ID of a folder",
      "remoteOptions": true
    },
    {
      "name": "articleId",
      "type": "integer",
      "label": "Article ID",
      "description": "The ID of an article",
      "remoteOptions": true
    },
    {
      "name": "title",
      "type": "string",
      "label": "Title",
      "description": "Title of the article",
      "optional": true
    },
    {
      "name": "description",
      "type": "string",
      "label": "Description",
      "description": "Description of the article",
      "optional": true
    },
    {
      "name": "status",
      "type": "integer",
      "label": "Status",
      "description": "Status of the article",
      "options": [
        {
          "label": "Draft",
          "value": 1
        },
        {
          "label": "Published",
          "value": 2
        }
      ],
      "optional": true
    },
    {
      "name": "seoData",
      "type": "object",
      "label": "SEO Data",
      "description": "Meta data for search engine optimization. Allows meta_title, meta_description and meta_keywords",
      "optional": true
    },
    {
      "name": "tags",
      "type": "string[]",
      "label": "Tags",
      "description": "Tags for the article",
      "optional": true
    }
  ]
}
