{
  "name": "Get Contact",
  "description": "Gets a contact. [See the documentation](https://developers.hubspot.com/docs/api/crm/contacts#endpoint?spec=GET-/crm/v3/objects/contacts/{contactId})",
  "component_type": "action",
  "version": "0.0.28",
  "key": "hubspot-get-contact",
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": true,
    "destructiveHint": false
  },
  "configurable_props": [
    {
      "name": "hubspot",
      "type": "app",
      "app": "hubspot"
    },
    {
      "name": "objectId",
      "type": "string",
      "label": "Contact ID",
      "description": "Hubspot's internal ID for the contact",
      "useQuery": true,
      "remoteOptions": true,
      "reloadProps": true
    },
    {
      "name": "info",
      "type": "alert",
      "alertType": "info",
      "content": "",
      "hidden": true
    },
    {
      "name": "additionalProperties",
      "type": "string[]",
      "label": "Additional properties to retrieve",
      "optional": true,
      "remoteOptions": true
    }
  ]
}
