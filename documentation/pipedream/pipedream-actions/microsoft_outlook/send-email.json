{
  "name": "Send Email",
  "description": "Send an email to one or multiple recipients, [See the docs](https://docs.microsoft.com/en-us/graph/api/user-sendmail)",
  "component_type": "action",
  "version": "0.0.22",
  "key": "microsoft_outlook-send-email",
  "annotations": {
    "readOnlyHint": false,
    "openWorldHint": true,
    "destructiveHint": false
  },
  "configurable_props": [
    {
      "name": "microsoftOutlook",
      "type": "app",
      "app": "microsoft_outlook"
    },
    {
      "name": "recipients",
      "label": "Recipients",
      "description": "Array of email addresses",
      "type": "string[]",
      "optional": true,
      "default": []
    },
    {
      "name": "ccRecipients",
      "label": "CC Recipients",
      "description": "Array of email addresses",
      "type": "string[]",
      "optional": true,
      "default": []
    },
    {
      "name": "bccRecipients",
      "label": "BCC Recipients",
      "description": "Array of email addresses",
      "type": "string[]",
      "optional": true,
      "default": []
    },
    {
      "name": "subject",
      "label": "Subject",
      "description": "Subject of the email",
      "type": "string",
      "optional": true
    },
    {
      "name": "contentType",
      "label": "Content Type",
      "description": "Content type (default `text`)",
      "type": "string",
      "optional": true,
      "options": ["text", "html"],
      "default": "text"
    },
    {
      "name": "content",
      "label": "Content",
      "description": "Content of the email in text or html format",
      "type": "string",
      "optional": true
    },
    {
      "name": "files",
      "type": "string[]",
      "label": "File Paths or URLs",
      "description": "Provide either an array of file URLs or an array of paths to a files in the /tmp directory (for example, /tmp/myFile.pdf).",
      "optional": true
    },
    {
      "name": "expand",
      "label": "Expand",
      "description": "Additional email details, [See object definition](https://docs.microsoft.com/en-us/graph/api/resources/message)",
      "type": "object",
      "optional": true
    }
  ]
}
